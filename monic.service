#!/bin/sh /etc/rc.common
 
START=90
STOP=01
USE_PROCD=1
  
start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/monic
	procd_set_param pidfile /var/run/monic.pid
	procd_set_param respawn 10 10 10
	procd_set_param term_timeout 60
	procd_set_param stdout 1
    procd_set_param stderr 1
	procd_close_instance
}
 
stop_service() {
	echo "monic service is going to stop"
}